[Unit]
Description=Pare-feu nftables de la plateforme
After=network-pre.target
Before=network-online.target docker.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/platform.nft
# cloisonnement des applis (généré par la console)
ExecStart=-/bin/sh -c '[ ! -f /etc/nftables.d/hangar-apps.nft ] || /usr/sbin/nft -f /etc/nftables.d/hangar-apps.nft'
ExecStop=/usr/sbin/nft delete table inet platform
ExecStop=-/usr/sbin/nft delete table inet hangarapps
[Install]
WantedBy=multi-user.target
