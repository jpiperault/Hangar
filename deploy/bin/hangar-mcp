#!/usr/bin/env python3
"""Serveur MCP de Hangar : Claude (Claude Code, Claude Desktop…) pilote Hangar par son API à jetons.

Un seul fichier, Python 3.9+ sans dépendance, lancé sur TON ordinateur par le client MCP (entrée/sortie standard).
Variables :
  HANGAR_URL          adresse de la console, ex. https://192.168.1.10:8443
  HANGAR_TOKEN        jeton d'API (Mon compte ou Réglages › Jetons d'API) ; portée « lecture » ou « déploiement »
  HANGAR_FINGERPRINT  empreinte SHA-256 du certificat de la console (affichée à côté des jetons) : le certificat est
                      auto-signé, il est donc épinglé ; sans elle, HANGAR_INSECURE=1 accepte n'importe quel certificat
Claude Code :
  claude mcp add hangar -e HANGAR_URL=https://… -e HANGAR_TOKEN=hgr_… -e HANGAR_FINGERPRINT=… -- python3 /chemin/hangar-mcp
"""
import hashlib
import json
import os
import socket
import ssl
import sys
import urllib.parse
import http.client

VERSION = "1.0"
PROTOCOL = "2025-06-18"

TOOLS = [
    {"name": "list_apps", "description": "Liste les applis hébergées par Hangar : état, version, machine, adresse publique.",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "app_status", "description": "Détail d'une appli : état, versions, adresses, construction (technologie reconnue), "
                                          "et ses derniers événements (déploiements, erreurs, healthchecks).",
     "inputSchema": {"type": "object", "properties": {"slug": {"type": "string", "description": "identifiant de l'appli"},
                                                      "events": {"type": "integer", "description": "nombre d'événements (30)"}},
                     "required": ["slug"]}},
    {"name": "app_logs", "description": "Logs du conteneur de l'appli (sortie standard), pour diagnostiquer une panne.",
     "inputSchema": {"type": "object", "properties": {
         "slug": {"type": "string"}, "period": {"type": "string", "enum": ["", "1h", "24h", "168h"],
                                                "description": "vide : 300 dernières lignes"},
         "query": {"type": "string", "description": "texte cherché, ou re:expression"},
         "errors_only": {"type": "boolean"}, "limit": {"type": "integer", "description": "lignes au plus (300)"}},
         "required": ["slug"]}},
    {"name": "app_traffic", "description": "Trafic de l'appli : visiteurs, pages vues, erreurs serveur, temps de réponse, "
                                           "pages, origines, pays, comportements suspects.",
     "inputSchema": {"type": "object", "properties": {"slug": {"type": "string"},
                                                      "range": {"type": "string", "enum": ["1h", "24h", "7j", "30j"]}},
                     "required": ["slug"]}},
    {"name": "deploy_app", "description": "Déploie une version (tag d'image, ou branche/commit d'un dépôt Git ; vide : la version "
                                          "en ligne, reconstruite). Healthcheck, puis retour automatique en cas d'échec.",
     "inputSchema": {"type": "object", "properties": {"slug": {"type": "string"}, "version": {"type": "string"}},
                     "required": ["slug"]}},
    {"name": "app_action", "description": "Démarre, arrête ou redémarre une appli.",
     "inputSchema": {"type": "object", "properties": {"slug": {"type": "string"},
                                                      "action": {"type": "string", "enum": ["start", "stop", "restart"]}},
                     "required": ["slug", "action"]}},
]


class HangarError(Exception):
    pass


def _conn():
    url = urllib.parse.urlsplit(os.environ.get("HANGAR_URL", ""))
    if url.scheme != "https" or not url.hostname:
        raise HangarError("HANGAR_URL manquante ou invalide (https://<console>:8443)")
    fp = os.environ.get("HANGAR_FINGERPRINT", "").replace(":", "").strip().lower()
    ctx = ssl.create_default_context()
    if fp or os.environ.get("HANGAR_INSECURE") == "1":
        ctx.check_hostname, ctx.verify_mode = False, ssl.CERT_NONE   # certificat auto-signé : épinglé ci-dessous
    c = http.client.HTTPSConnection(url.hostname, url.port or 443, context=ctx, timeout=60)
    c.connect()
    if fp:
        got = hashlib.sha256(c.sock.getpeercert(binary_form=True)).hexdigest()
        if got != fp:
            c.close()
            raise HangarError("le certificat de la console ne correspond pas à HANGAR_FINGERPRINT : connexion refusée")
    return c


def api(method, path, body=None):
    tok = os.environ.get("HANGAR_TOKEN", "")
    if not tok.startswith("hgr_"):
        raise HangarError("HANGAR_TOKEN manquant (jeton d'API créé dans la console)")
    try:
        c = _conn()
        c.request(method, "/api/v1" + path, body=json.dumps(body) if body is not None else None,
                  headers={"Authorization": f"Bearer {tok}", "Content-Type": "application/json", "User-Agent": f"hangar-mcp/{VERSION}"})
        r = c.getresponse()
        data = r.read()
    except (OSError, socket.timeout, ssl.SSLError, http.client.HTTPException) as e:
        raise HangarError(f"console injoignable ({e})")
    try:
        out = json.loads(data or b"{}")
    except ValueError:
        raise HangarError(f"réponse inattendue (HTTP {r.status})")
    if r.status >= 400:
        raise HangarError(out.get("error") or f"HTTP {r.status}")
    return out


def _slug(a):
    s = str(a.get("slug") or "")
    if not s or "/" in s or ".." in s:
        raise HangarError("slug manquant ou invalide")
    return urllib.parse.quote(s, safe="")


def call(name, a):
    if name == "list_apps":
        return api("GET", "/apps")
    if name == "app_status":
        out = api("GET", f"/apps/{_slug(a)}")
        out["events"] = api("GET", f"/apps/{_slug(a)}/events?limit={int(a.get('events') or 30)}")["events"]
        return out
    if name == "app_logs":
        q = urllib.parse.urlencode({"period": a.get("period") or "", "q": a.get("query") or "",
                                    "errors": "1" if a.get("errors_only") else "", "limit": int(a.get("limit") or 300)})
        return api("GET", f"/apps/{_slug(a)}/logs?{q}")
    if name == "app_traffic":
        return api("GET", f"/apps/{_slug(a)}/traffic?range={urllib.parse.quote(a.get('range') or '24h')}")
    if name == "deploy_app":
        return api("POST", f"/apps/{_slug(a)}/deploy", {"version": a.get("version") or ""})
    if name == "app_action":
        if a.get("action") not in ("start", "stop", "restart"):
            raise HangarError("action : start, stop ou restart")
        return api("POST", f"/apps/{_slug(a)}/{a['action']}", {})
    raise HangarError(f"outil inconnu : {name}")


def handle(msg):
    mid, method, params = msg.get("id"), msg.get("method"), msg.get("params") or {}
    if method == "initialize":
        return {"protocolVersion": params.get("protocolVersion") or PROTOCOL, "capabilities": {"tools": {}},
                "serverInfo": {"name": "hangar", "version": VERSION},
                "instructions": "Hangar héberge des applis (conteneurs Docker) sur une ou plusieurs machines. Pour un "
                                "problème : app_status puis app_logs. Déployer ou arrêter change la production : "
                                "demande confirmation à l'utilisateur avant deploy_app ou app_action."}
    if method == "ping":
        return {}
    if method == "tools/list":
        return {"tools": TOOLS}
    if method == "tools/call":
        try:
            out = call(params.get("name"), params.get("arguments") or {})
            return {"content": [{"type": "text", "text": json.dumps(out, ensure_ascii=False, indent=1)}], "isError": False}
        except HangarError as e:
            return {"content": [{"type": "text", "text": f"Erreur : {e}"}], "isError": True}
    if mid is None:   # notification (notifications/initialized…) : pas de réponse
        return None
    raise LookupError(method)


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        mid = msg.get("id")
        try:
            res = handle(msg)
            if mid is None:
                continue
            out = {"jsonrpc": "2.0", "id": mid, "result": res if res is not None else {}}
        except LookupError as e:
            out = {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"méthode inconnue : {e}"}}
        except Exception as e:   # jamais de plantage du serveur : l'erreur repart au client
            out = {"jsonrpc": "2.0", "id": mid, "error": {"code": -32603, "message": str(e)}}
        sys.stdout.write(json.dumps(out, ensure_ascii=False) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
